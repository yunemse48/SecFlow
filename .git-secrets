[secrets]
    patterns = 
        password\s*[=:]\s*['\"].*['\"]
        secret\s*[=:]\s*['\"].*['\"]
        api[_-]?key\s*[=:]\s*['\"].*['\"]
        token\s*[=:]\s*['\"].*['\"]
        credential\s*[=:]\s*['\"].*['\"]
        private[_-]?key\s*[=:]\s*['\"].*['\"]
        access[_-]?token\s*[=:]\s*['\"].*['\"]
        [0-9a-zA-Z]{16,64}
        -----BEGIN (RSA|DSA|EC|OPENSSH) PRIVATE KEY-----
        xoxb-[0-9a-zA-Z-]+
        sk_live_[0-9a-zA-Z-]+
        sk_test_[0-9a-zA-Z-]+
        sk_live_[0-9a-zA-Z]{24,}
        sk_test_[0-9a-zA-Z]{24,}
        sk_live_[0-9a-zA-Z-]{24,}
        sk_test_[0-9a-zA-Z-]{24,}
